<% content_for :title, "New Password" %>

<h2>Set New Password</h2>

<%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put }) do |f| %>
  <%= render "devise/shared/error_messages", resource: resource %>
  <%= f.hidden_field :reset_password_token %>

  <div class="form-group">
    <%= f.label :password, "New password" %>
    <% if @minimum_password_length %>
      <em>(<%= @minimum_password_length %> characters minimum)</em>
    <% end %>
    <%= f.password_field :password, autofocus: true, autocomplete: "new-password", placeholder: "Enter new password" %>
  </div>

  <div class="form-group">
    <%= f.label :password_confirmation, "Confirm new password" %>
    <%= f.password_field :password_confirmation, autocomplete: "new-password", placeholder: "Confirm new password" %>
  </div>

  <div class="form-actions">
    <%= f.submit "Change Password" %>
  </div>
<% end %>

<div class="auth-links">
  <%= link_to "Back to sign in", new_session_path(resource_name) %>
</div>
