<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="turbo-cache-control" content="no-preview">

    <%# CSRF token – readable by client-side fetch modules via:
        document.querySelector('meta[name="csrf-token"]')?.content %>
    <meta name="csrf-token" content="<%= form_authenticity_token %>">

    <title><%= content_for?(:title) ? yield(:title) : "ElearnNgx" %></title>
    <meta name="description" content="<%= content_for?(:description) ? yield(:description) : "elearn-ngx" %>">

    <%# Vite entrypoints ────────────────────────────────────────────────── %>
    <%= vite_client_tag %>
    <%= vite_javascript_tag "application.ts", defer: true %>
    <%= vite_javascript_tag "web_components.ts", defer: true %>
    <%= vite_stylesheet_tag "application", media: "all" if ViteRails.instance.manifest.path_for("application.css") rescue nil %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= yield :head %>
  </head>

  <body class="<%= content_for?(:body_class) ? yield(:body_class) : "" %>">
    <%# Global Navigation Island %>
    <% if user_signed_in? %>
      <app-navigation
        username="<%= current_user.username %>"
        avatar_url="<%= current_user.avatar_url %>"
        role="<%= current_user.role_name %>"
        authenticated="true"
      ></app-navigation>
    <% else %>
      <app-navigation authenticated="false"></app-navigation>
    <% end %>

    <%# Flash messages %>
    <% flash.each do |type, message| %>
      <div class="alert alert-warning" role="alert"><%= message %></div>
    <% end %>

    <main class="main-content">
      <%= yield %>
    </main>

    <%# Initialize theme on page load to prevent flash of light mode %>
    <script>
      (function() {
        var stored = localStorage.getItem('elearn-theme-mode');
        var systemPrefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        var isDark = stored === 'dark' || (stored === 'system' && systemPrefersDark) || (!stored && systemPrefersDark);
        if (isDark) {
          document.documentElement.setAttribute('data-theme', 'dark');
          document.body.classList.add('dark-mode');
        }
      })();
    </script>
  </body>
</html>
