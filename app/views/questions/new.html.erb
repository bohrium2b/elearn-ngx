<div class="container mt-4">
    <h1>Create New Question</h1>
    <%= react_island_tag("multi-choice-editor", { question: @sample_question.config_data, data_submit_path: questions_path, data_submit_method: "POST" }) %>
    <%= link_to questions_path do %>
        <md-button variant="outlined">Back to Questions</md-button>
    <% end %>
    <div style="margin-top: 20px;"></div>
</div>