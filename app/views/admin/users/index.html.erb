<div class="container mx-auto px-4 py-8">
  <div class="flex justify-between items-center mb-6">
    <h1 class="text-2xl font-bold">User Management</h1>
  </div>

  <% if @users.any? %>
    <div class="overflow-x-auto">
      <table class="table w-full">
        <thead>
          <tr>
            <th>Username</th>
            <th>Email</th>
            <th>Role</th>
            <th>Sessions</th>
            <th>Joined</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% @users.each do |user| %>
            <tr>
              <td><%= user.username %></td>
              <td><%= user.email %></td>
              <td>
                <span class="badge badge-<%= user.admin? ? 'error' : user.instructor? ? 'warning' : 'info' %>">
                  <%= user.role_name.capitalize %>
                </span>
              </td>
              <td><%= user.assessment_sessions.count %></td>
              <td><%= user.created_at.strftime("%B %d, %Y") %></td>
              <td>
                <div class="flex gap-2">
                  <a href="<%= edit_admin_user_path(user) %>" class="btn btn-sm btn-secondary">
                    Edit
                  </a>
                  <%= button_to "Delete", admin_user_path(user), method: :delete, 
                      class: "btn btn-sm btn-error",
                      data: { confirm: "Are you sure you want to delete this user?" } %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="text-center py-12">
      <p class="text-gray-500">No users found.</p>
    </div>
  <% end %>
</div>
